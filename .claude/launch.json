{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nationalcloset",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4117",
        "--directory",
        "."
      ],
      "port": 4117
    },
    {
      "name": "nationalcloset-dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4118",
        "--directory",
        "dist"
      ],
      "port": 4118
    },
    {
      "name": "nationalcloset-local-crm",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "pages",
        "dev",
        "dist",
        "--port",
        "4119",
        "--persist-to",
        ".wrangler/local-crm"
      ],
      "port": 4119
    }
  ]
}
